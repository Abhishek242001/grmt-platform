# Secrets — never commit real values (development_rule.md §6.3)
.env
backend/.env
backend/secrets/
*.pem

# Python
backend/.venv/
__pycache__/
*.pyc
*.db
backend/grmt_dev.db
backend/test_grmt.db

# Logs — log.txt is a local/dev artifact, not something to version-control
# (it will contain request IDs and timing data specific to your machine)
log.txt
log.txt.*
backend/test_log.txt

# Node / frontend
frontend/node_modules/
frontend/.next/
frontend/out/

# AI service model caches / large downloads
ai-services/embeddings/.venv/
ai-services/gpu-inference/.venv/
ai-services/**/corpus.index
**/*.gguf
**/Binoculars/

# corpus-builder output (large, regenerable — see corpus-builder/README.md)
corpus-builder/output/

# OS / editor
.DS_Store
.vscode/
.idea/
