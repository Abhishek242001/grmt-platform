# Copy to backend/.env and fill in real values. Never commit the real .env —
# see development_rule.md §6.3.

# --- Database ---
# Local dev default (no setup needed): sqlite:///./grmt_dev.db
# Local docker-compose Postgres:       postgresql://grmt:grmt_dev_password@localhost:5432/grmt
# Production (Supabase/Neon):          postgresql://<user>:<pass>@<host>:5432/<db>
DATABASE_URL=sqlite:///./grmt_dev.db

# --- Auth / JWT (RS256) — generate with: python scripts/generate_keys.py ---
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- App ---
ENVIRONMENT=development
LOG_FILE_PATH=../log.txt
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- External AI services — point these at your Lightning AI Studio URLs
# once deployed (development_rule.md §1.3); localhost defaults work for
# local docker-compose services (LanguageTool, GROBID) only. ---
LANGUAGETOOL_URL=http://localhost:8010
GROBID_URL=http://localhost:8070
EMBEDDINGS_SERVICE_URL=http://localhost:8001
GPU_INFERENCE_SERVICE_URL=http://localhost:8002
OLLAMA_URL=http://localhost:11434

# --- Optional hosted-LLM fallback (master doc §7.3 Day 11) ---
GROQ_API_KEY=

# --- Reference corpus build (corpus-builder/, master doc §3.4) ---
S2AG_API_KEY=
CORE_API_KEY=

# --- Storage / PDF signed URLs (development_rule.md §6.4) ---
STORAGE_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_KEY_xxxxxxxxxx
PDF_SIGNED_URL_TTL_SECONDS=300
